# Copy to .env.local and fill from Firebase Console → Project settings → Your apps.
# .env.local is gitignored. Vite embeds VITE_* into the client bundle at build time
# (the web apiKey is public-by-design; real security = Firestore rules + key restrictions).

# Teacher email for /admin/submissions (client UX check only).
VITE_TEACHER_EMAIL=your-teacher-email@gmail.com

# Paste a new Browser key from Google Cloud Console (Credentials).
VITE_FIREBASE_API_KEY=REPLACE_WITH_NEW_BROWSER_KEY
VITE_FIREBASE_AUTH_DOMAIN=english-simple-trainer.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=english-simple-trainer
VITE_FIREBASE_STORAGE_BUCKET=english-simple-trainer.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=788677527740
VITE_FIREBASE_APP_ID=1:788677527740:web:2a07de2c1e1d94d62ee8b9
