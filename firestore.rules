rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Replace PLACEHOLDER with the same email as VITE_TEACHER_EMAIL
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'YOUR_TEACHER_EMAIL@gmail.com';
    }

    function teacherReviewOnly() {
      return isTeacher()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reviewed', 'reviewedAt']);
    }

    match /homeworkAnswers/{id} {
      allow create: if
        request.resource.data.studentName is string
        && request.resource.data.studentName.size() >= 2
        && request.resource.data.studentName.size() <= 80
        && request.resource.data.lessonId is string
        && request.resource.data.lessonId.size() > 0
        && request.resource.data.lessonId.size() <= 20
        && request.resource.data.writing is string
        && request.resource.data.writing.size() >= 10
        && request.resource.data.writing.size() <= 8000
        && request.resource.data.testDone is bool
        && request.resource.data.quizDone is bool
        && (!('quizScore' in request.resource.data)
            || request.resource.data.quizScore is int)
        && request.resource.data.keys().hasAll([
          'studentName', 'lessonId', 'writing', 'testDone', 'quizDone', 'createdAt'
        ]);

      allow read, list: if isTeacher();
      allow update: if teacherReviewOnly();
      allow delete: if false;
    }

    match /writingSubmissions/{id} {
      allow create: if
        request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 8000
        && request.resource.data.page in ['about-me', 'self-study'];

      allow read, list: if isTeacher();
      allow update: if teacherReviewOnly();
      allow delete: if false;
    }

    match /studentVocab/{id} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.en is string
        && request.resource.data.en.size() >= 1
        && request.resource.data.en.size() <= 80
        && request.resource.data.ua is string
        && request.resource.data.ua.size() >= 1
        && request.resource.data.ua.size() <= 80
        && request.resource.data.example is string
        && request.resource.data.example.size() <= 200
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() >= 1
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.keys().hasAll([
          'en', 'ua', 'example', 'ownerUid', 'ownerName', 'createdAt'
        ]);

      allow read, list: if request.auth != null && (
        isTeacher() || resource.data.ownerUid == request.auth.uid
      );

      allow update: if false;
      allow delete: if request.auth != null && (
        isTeacher() || resource.data.ownerUid == request.auth.uid
      );
    }
  }
}
